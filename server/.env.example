MOMENPAIR_ENVIRONMENT=development
MOMENPAIR_DEBUG=true
MOMENPAIR_SECRET_KEY=replace-with-at-least-32-random-characters
MOMENPAIR_SOCIAL_AUTH_MODE=fake
MOMENPAIR_DATABASE_URL=mysql+asyncmy://momenpair:momenpair@127.0.0.1:3306/momenpair
MOMENPAIR_REDIS_URL=redis://127.0.0.1:6379/0
MOMENPAIR_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
MOMENPAIR_OBJECT_STORAGE_ACCESS_KEY=momenpair
MOMENPAIR_OBJECT_STORAGE_SECRET_KEY=replace-with-a-local-secret
MOMENPAIR_OBJECT_STORAGE_BUCKET=momenpair-media
MOMENPAIR_CORS_ORIGINS=["http://localhost:3000"]
MOMENPAIR_ALLOWED_HOSTS=["localhost","127.0.0.1"]
