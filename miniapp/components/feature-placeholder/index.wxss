.placeholder {
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  border-radius: var(--mp-radius-card);
  background-color: var(--mp-surface-container);
  border: 1rpx solid var(--mp-outline);
}

.placeholder__badge {
  align-self: flex-start;
  padding: 8rpx 24rpx;
  border-radius: var(--mp-radius-pill);
  background-color: var(--mp-secondary-container);
  color: var(--mp-on-secondary-container);
  font-size: 24rpx;
}

.placeholder__text {
  margin-top: var(--mp-space-md);
  color: var(--mp-on-surface-variant);
  font-size: 26rpx;
  line-height: 1.6;
}
