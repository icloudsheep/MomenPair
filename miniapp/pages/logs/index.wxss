.logs__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--mp-space-md);
}

.logs__heading {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.logs__create,
.logs__more {
  border-radius: 16rpx;
  background: var(--mp-primary);
  color: var(--mp-on-primary);
}

.logs__error {
  display: block;
  margin-top: var(--mp-space-md);
}

.logs__editor-title,
.logs__empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.logs__input,
.logs__textarea {
  margin-top: var(--mp-space-md);
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--mp-outline);
  border-radius: 20rpx;
  background: var(--mp-surface);
  box-sizing: border-box;
}

.logs__textarea {
  width: 100%;
  min-height: 260rpx;
}

.logs__editor-actions,
.logs__actions,
.logs__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--mp-space-sm);
}

.logs__editor-actions {
  margin-top: var(--mp-space-md);
  justify-content: flex-end;
}

.logs__list,
.logs__card {
  display: flex;
  flex-direction: column;
  gap: var(--mp-space-md);
}

.logs__author {
  font-size: 26rpx;
  font-weight: 600;
}

.logs__title {
  margin-top: var(--mp-space-md);
  font-size: 38rpx;
  font-weight: 600;
}

.logs__subtitle,
.logs__body,
.logs__empty-description {
  display: block;
  margin-top: 12rpx;
}

.logs__subtitle {
  color: var(--mp-on-surface-variant);
  font-size: 26rpx;
}

.logs__body {
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.logs__actions {
  margin-top: var(--mp-space-md);
}

.logs__action {
  margin: 0;
  border-radius: 16rpx;
}

.logs__photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: var(--mp-space-md);
}

.logs__photo-wrap {
  position: relative;
}

.logs__photo {
  width: 100%;
  height: 180rpx;
  border-radius: 14rpx;
}

.logs__photo-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 48rpx;
  min-width: 48rpx;
  height: 48rpx;
  padding: 0;
  border-radius: 12rpx;
  line-height: 44rpx;
}

.logs__action--liked {
  color: var(--mp-error);
}

.logs__loading {
  text-align: center;
}

.logs__more {
  margin-top: var(--mp-space-lg);
}
